{
  "name": "learn-flutter-sdk",
  "version": "1.0.0",
  "description": "Learning repository for Flutter SDK with Slidev presentations",
  "scripts": {
    "dev": "slidev slides/index.md --open",
    "build": "slidev build slides/index.md --base /learn_flutter_sdk/slides/ --out dist",
    "build:pr": "slidev build slides/index.md --out dist",
    "export": "slidev export slides/index.md"
  },
  "dependencies": {
    "@slidev/cli": "^0.48.0",
    "@slidev/theme-default": "latest"
  },
  "devDependencies": {
    "playwright-chromium": "^1.40.0"
  }
}
